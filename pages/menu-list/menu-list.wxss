.container {
  min-height: 100vh;
  background: #f5f7fa;
  padding: 32rpx;
  padding-bottom: 200rpx;
  box-sizing: border-box;
}

.menu-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.menu-card-body {
  flex: 1;
}

.menu-card-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.menu-card-count {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

.menu-card-delete {
  font-size: 44rpx;
  color: #ccc;
  padding: 16rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 240rpx;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
}

.empty-hint {
  font-size: 26rpx;
  color: #ccc;
  margin-top: 16rpx;
}

.create-btn-wrapper {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx;
  background: linear-gradient(transparent, #f5f7fa 20%);
}

.create-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  background: #333;
  color: #fff;
  border-radius: 24rpx;
  font-size: 32rpx;
  border: none;
}

.create-btn::after {
  border: none;
}
