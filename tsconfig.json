{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "lib": ["ES2020"],
    "outDir": "./",
    "rootDir": "./",
    "baseUrl": ".",
    "noEmit": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "cloudfunctions"]
}
